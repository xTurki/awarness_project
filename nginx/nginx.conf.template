# Template rendered by envsubst when the container starts.
# Only environment variables are replaced, so $host etc. are kept.

upstream backend {
    server backend:8000;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    # UPLOAD_MAX_MB + 1 MB, so the app (not nginx) reports oversized uploads.
    client_max_body_size ${UPLOAD_MAX_PLUS_MARGIN}m;

    # Static files (read-only mount).
    location /static/ {
        alias /srv/static/;
        access_log off;
        expires 1h;
    }

    # Uploaded images.
    location /uploads/ {
        alias /srv/uploads/;
        access_log off;
        expires 1h;
    }

    # Show a maintenance page (503) while the backend is restarting.
    error_page 502 503 504 =503 /maintenance.html;

    location = /maintenance.html {
        root /usr/share/nginx/html;
        internal;
        # Don't cache the maintenance page.
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass         http://backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Used by the app to set the Secure cookie flag.
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 30s;
    }
}
