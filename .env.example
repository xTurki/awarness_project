# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value below is a placeholder; none of them is a working credential.

# --- Database -----------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lms
MYSQL_USER=lms
MYSQL_PASSWORD=change-me
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Application --------------------------------------------------------
# Any long random string. Rotating it invalidates outstanding CSRF tokens.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Email --------------------------------------------------------------
# A Google App Password, not an account password. Sign-in fails without it,
# and there is no bypass: verify outbound access to smtp.gmail.com:587 first.
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=you@example.com

# --- Public address -----------------------------------------------------
# The connector token from the Cloudflare tunnel this platform is published
# through. docker-compose.yml requires it: leave it empty and the tunnel
# container starts, finds no token, and restarts forever.
#
# To run without publishing anything, name the three platform services
# instead and the tunnel is never created:
#   docker compose up -d --build db backend nginx
#
# One rule, learned the hard way: every connector running on a tunnel must be
# able to reach every origin that tunnel serves. Cloudflare spreads requests
# across all of them, so a second connector that cannot reach nginx turns into
# an intermittent 502 that leaves no trace in this stack's logs.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Uploads ------------------------------------------------------------
# Megabytes per image. The application and nginx both derive their limit from
# this one number, so they cannot disagree.
UPLOAD_MAX_MB=5

# --- Scheduling ---------------------------------------------------------
# How many days before a due date somebody is warned, and the hour the daily
# sweep runs. Early enough that anyone due is told before their working day.
DUE_SOON_LEAD_DAYS=14
SCHEDULER_HOUR_UTC=6

# --- Development --------------------------------------------------------
# Shows the sign-in code on the page that asks for it. Set to false for
# production; app/development.py explains how to remove it altogether.
SHOW_LOGIN_CODE=true

# --- Study assistant ----------------------------------------------------
# A Gemini API key from aistudio.google.com/apikey. Leave it empty and the
# assistant is simply absent: no panel, no route, nothing changes.
# The page a trainee is reading and their question are sent to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Timings and limits -------------------------------------------------
CODE_TTL_MINUTES=10
SESSION_HOURS=12
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=5
