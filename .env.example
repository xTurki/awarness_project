# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value below is a placeholder; none of them is a working credential.

# --- Database -----------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lms
MYSQL_USER=lms
MYSQL_PASSWORD=change-me
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Application --------------------------------------------------------
# Required by the settings, but nothing reads it: sessions are random tokens
# stored in the database, and CSRF tokens are random values, not signed ones.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Email --------------------------------------------------------------
# Mail goes through Brevo's SMTP relay. The login and the SMTP key come from
# Brevo, SMTP & API, SMTP tab; the key starts with xsmtpsib-. Brevo accepts
# connections only from authorised IP addresses (Security, Authorised IPs), and
# SMTP_FROM must be a verified sender in the same Brevo account. If sending
# fails the code is still printed to the backend log, and the code page says so.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxxxxxxx@smtp-brevo.com
SMTP_APP_PASSWORD=xsmtpsib-your-smtp-key
SMTP_FROM=you@example.com

# --- Uploads ------------------------------------------------------------
# Megabytes per image. The application and nginx both derive their limit from
# this one number, so they cannot disagree.
UPLOAD_MAX_MB=5

# --- Scheduling ---------------------------------------------------------
# How many days before a due date somebody is warned, and the hour the daily
# sweep runs. Early enough that anyone due is told before their working day.
DUE_SOON_LEAD_DAYS=14
SCHEDULER_HOUR_UTC=6

# --- Development --------------------------------------------------------
# Shows the sign-in code on the page that asks for it. Set to false for
# production; app/development.py explains how to remove it altogether.
SHOW_LOGIN_CODE=true

# --- Study assistant ----------------------------------------------------
# A Gemini API key from aistudio.google.com/apikey. Leave it empty and the
# assistant is simply absent: no panel, no route, nothing changes.
# The page a trainee is reading and their question are sent to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Timings and limits -------------------------------------------------
CODE_TTL_MINUTES=10
SESSION_HOURS=12
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=5
