# Copy to .env and fill in the values. Don't commit .env.

# --- Database -----------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lms
MYSQL_USER=lms
MYSQL_PASSWORD=change-me
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Application --------------------------------------------------------
# Required but currently unused.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Email --------------------------------------------------------------
# Brevo SMTP. Get the login and key from Brevo > SMTP & API > SMTP.
# Your server IP must be in Brevo's authorised IPs, and SMTP_FROM must be a
# verified sender. If sending fails, the login code is printed in the backend log.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxxxxxxx@smtp-brevo.com
SMTP_APP_PASSWORD=xsmtpsib-your-smtp-key
SMTP_FROM=you@example.com

# --- Uploads ------------------------------------------------------------
# Max image size in MB (used by the app and nginx).
UPLOAD_MAX_MB=5

# --- Scheduling ---------------------------------------------------------
# Days of warning before a due date, and the UTC hour the daily job runs.
DUE_SOON_LEAD_DAYS=14
SCHEDULER_HOUR_UTC=6

# --- Development --------------------------------------------------------
# Show the login code on the verify page. Set to false in production.
SHOW_LOGIN_CODE=true

# --- Study assistant ----------------------------------------------------
# Gemini API key (aistudio.google.com/apikey). Leave empty to disable.
# Note: the page text and the question are sent to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Timings and limits -------------------------------------------------
CODE_TTL_MINUTES=10
SESSION_HOURS=12
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=5
