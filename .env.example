# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value below is a placeholder; none of them is a working credential.

# --- Database -----------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lms
MYSQL_USER=lms
MYSQL_PASSWORD=change-me
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Application --------------------------------------------------------
# Any long random string. Rotating it invalidates outstanding CSRF tokens.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Email --------------------------------------------------------------
# A Google App Password, not an account password. Sign-in fails without it,
# and there is no bypass: verify outbound access to smtp.gmail.com:587 first.
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=you@example.com

# --- Timings and limits -------------------------------------------------
CODE_TTL_MINUTES=10
SESSION_HOURS=12
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=5
